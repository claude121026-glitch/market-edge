# Market Edge settings on the server. Edit with:  sudo nano /etc/market_edge.env
# Lines starting with # are ignored. Leave a value empty to switch that feature off.

# WhatsApp alerts via CallMeBot (free, personal use). Setup: see DEPLOY.md, step 5.
WHATSAPP_PHONE=
WHATSAPP_APIKEY=

# Optional: Telegram as well (or instead)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: better news scoring with a free Gemini key from aistudio.google.com
GEMINI_API_KEY=

# Optional: paper-trading size
ME_RISK_PER_TRADE=1000
ME_MAX_POSITION=200000
